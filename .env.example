# Server
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# Database
MONGO_URI=mongodb://mongo:27017/airport_platform

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# OCR provider (stub|tesseract|external)
OCR_PROVIDER=stub

# AI verification provider (stub|anthropic|openai)
AI_VERIFICATION_PROVIDER=stub
ANTHROPIC_API_KEY=

# Payment gateway (stub|stripe)
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=

# Notifications
NOTIFICATIONS_PROVIDER=stub
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Baggage rules
BAGGAGE_FREE_ALLOWANCE_KG=20
BAGGAGE_EXCESS_RATE_PER_KG=8
